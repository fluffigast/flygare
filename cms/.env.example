# Postgres lokalt (matchar docker-kommandot i README)
DATABASE_URL=postgres://postgres:flygare@localhost:5432/flygare

PAYLOAD_SECRET=change-this-to-a-random-secret
PAYLOAD_ADMIN_PASSWORD=change-me

# URL CMS själv svarar på (för Live Preview-iframe)
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# Frontend-adressen som bäddas in i Live Preview
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Lokal mediakatalog (default /app/media i prod)
MEDIA_DIR=./media

# Sätt till true för att hoppa över seed vid containerstart
SKIP_SEED=false
